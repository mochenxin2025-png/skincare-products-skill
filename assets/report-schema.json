{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skincare-products-skill/schema/v2.3/report",
  "title": "Cosmetic Analysis Report (Product Analysis Mode)",
  "description": "Product Analysis Mode report. Citation Mode uses the five-section form in output-format-spec.md §6 instead and does not produce a score. Every module named in SKILL.md Step 10 must be present: a module that was skipped still appears via top-level `skipped_modules`.",
  "type": "object",
  "required": [
    "meta",
    "first_principle",
    "product_objective",
    "ontology_summary",
    "ingredients",
    "architecture",
    "support_system",
    "marketing",
    "risks",
    "skin_adaptation",
    "interaction_analysis",
    "evidence",
    "confidence_detail",
    "scoring",
    "conclusion"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "version",
        "timestamp",
        "product_category",
        "confidence"
      ],
      "properties": {
        "version": {
          "type": "string",
          "description": "Report-format version. Bump with the skill release."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "product_category": {
          "type": "string",
          "enum": [
            "cleanser",
            "body-wash",
            "moisturizer",
            "serum",
            "sunscreen",
            "shampoo",
            "body-lotion",
            "hair-conditioner",
            "lip-balm",
            "anti-acne-serum",
            "exfoliation",
            "toner",
            "mask"
          ],
          "description": "One of the 13 framework categories. Categories whose weight profile lives in a spec file must be reported with the profile from that spec (SKILL.md Step 8)."
        },
        "category_modifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "infant"
            ]
          },
          "uniqueItems": true,
          "description": "Population modifiers applied on top of the base category — Infant is a modifier, not a category."
        },
        "confidence": {
          "type": "object",
          "required": [
            "score",
            "label",
            "mode"
          ],
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Overall M15 confidence, 0–100 (harmonic mean of the five factors). This is the same scale as SKILL.md Step 9 and the confidence-engine-spec label table. Factor values in confidence_detail are 0–1; only this overall score is 0–100."
            },
            "label": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low",
                "critical"
              ]
            },
            "mode": {
              "type": "string",
              "enum": [
                "standard",
                "conservative"
              ]
            }
          }
        }
      }
    },
    "first_principle": {
      "type": "object",
      "required": [
        "category",
        "objective"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "cleanser",
            "body-wash",
            "moisturizer",
            "serum",
            "sunscreen",
            "shampoo",
            "body-lotion",
            "hair-conditioner",
            "lip-balm",
            "anti-acne-serum",
            "exfoliation",
            "toner",
            "mask"
          ]
        },
        "objective": {
          "type": "string"
        }
      }
    },
    "product_objective": {
      "type": "object",
      "required": [
        "stated_purpose",
        "supported"
      ],
      "properties": {
        "stated_purpose": {
          "type": "string"
        },
        "supported": {
          "type": "boolean",
          "description": "Whether the formula can plausibly deliver the stated purpose"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "ontology_summary": {
      "type": "object",
      "required": [
        "categories"
      ],
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "count",
              "ingredients"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "ingredients": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "ingredients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "inci",
          "ontology"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "inci": {
            "type": "string"
          },
          "common_name": {
            "type": "string"
          },
          "ontology": {
            "type": "string",
            "description": "Exactly one primary category (M13); Risk [R] is additive and may be appended."
          },
          "mechanism": {
            "type": "string"
          },
          "evidence_level": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              null
            ]
          },
          "concentration": {
            "type": "object",
            "properties": {
              "known": {
                "type": "boolean"
              },
              "estimated_range": {
                "type": "string"
              },
              "method": {
                "type": "string",
                "enum": [
                  "declared",
                  "position_inferred",
                  "unknown"
                ]
              }
            }
          },
          "risk": {
            "type": "object",
            "properties": {
              "risk_type": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "prohibited"
                ]
              }
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "properties": {
        "carrier_system": {
          "type": "string"
        },
        "ph_range": {
          "type": "string"
        },
        "components": {
          "type": "object",
          "properties": {
            "emulsifiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stabilizers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "thickeners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "film_former": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "oil_phase": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "water_phase": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "assessment": {
          "type": "string"
        },
        "architecture_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "support_system": {
      "type": "object",
      "description": "Section ⑥ — ingredients that improve performance indirectly: humectants, barrier repair, antioxidants, chelators.",
      "required": [
        "ingredients"
      ],
      "properties": {
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "inci",
              "role"
            ],
            "properties": {
              "inci": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "evidence_level": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  null
                ]
              }
            }
          }
        },
        "assessment": {
          "type": "string"
        },
        "support_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "marketing": {
      "type": "object",
      "description": "Section ⑦ — marketing ingredients never score positively; exactly one deduction mechanism applies.",
      "required": [
        "ingredients",
        "deduction_mechanism"
      ],
      "properties": {
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "inci",
              "reason"
            ],
            "properties": {
              "inci": {
                "type": "string"
              },
              "ontology": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "marketing_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "positive_contribution": {
          "type": "number",
          "const": 0,
          "description": "Always 0 — marketing ingredients contribute nothing positive."
        },
        "deduction_mechanism": {
          "type": "string",
          "enum": [
            "external_penalty",
            "in_profile_dimension",
            "none"
          ],
          "description": "external_penalty for 5-dimension profiles; in_profile_dimension for Body Wash and Shampoo. Never both (scoring-algorithm.md §5)."
        },
        "penalty_applied": {
          "type": "number",
          "maximum": 0,
          "description": "Points deducted. 0 when no penalty applies."
        }
      }
    },
    "risks": {
      "type": "object",
      "properties": {
        "ingredients": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "inci": {
                "type": "string"
              },
              "risk_type": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              }
            }
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pair": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "type": {
                "type": "string",
                "enum": [
                  "synergy",
                  "antagonism",
                  "conflict",
                  "independent"
                ]
              },
              "mechanism": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "dimension_affected": {
                "type": "string"
              },
              "im": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1.2
              }
            }
          }
        }
      }
    },
    "skin_adaptation": {
      "type": "object",
      "required": [
        "compatibility"
      ],
      "properties": {
        "compatibility": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "skin_type",
              "suitability"
            ],
            "properties": {
              "skin_type": {
                "type": "string",
                "enum": [
                  "normal",
                  "dry",
                  "oily",
                  "combination",
                  "sensitive",
                  "acne-prone",
                  "seborrheic-dermatitis",
                  "rosacea",
                  "barrier-damaged",
                  "keratosis-pilaris",
                  "body-acne",
                  "infant"
                ]
              },
              "suitability": {
                "type": "string",
                "enum": [
                  "suitable",
                  "caution",
                  "not_recommended",
                  "unknown"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "interaction_analysis": {
      "type": "object",
      "description": "Section ⑩ — every pair evaluated, with the IM actually applied and where it came from.",
      "properties": {
        "rules_evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pair",
              "type",
              "im"
            ],
            "properties": {
              "pair": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "type": {
                "type": "string",
                "enum": [
                  "synergy",
                  "independent",
                  "antagonism",
                  "conflict"
                ]
              },
              "rule_id": {
                "type": "string"
              },
              "im": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1.2
              },
              "im_source": {
                "type": "string",
                "enum": [
                  "library_precise",
                  "type_default"
                ],
                "description": "library_precise when interaction-rules.md carries the pair; type_default only when graded by type with no rule of its own (scoring-algorithm.md §2.3)."
              },
              "dimension_affected": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "combined_im_capped": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.2
        }
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "overall_quality": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim": {
                "type": "string"
              },
              "evidence_level": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "source_type": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "confidence_detail": {
      "type": "object",
      "required": [
        "factors"
      ],
      "properties": {
        "factors": {
          "type": "object",
          "required": [
            "input_quality",
            "database_match_rate",
            "mechanism_certainty",
            "interaction_certainty",
            "concentration_certainty"
          ],
          "properties": {
            "input_quality": {
              "type": "object",
              "required": [
                "score"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "I — 0–1. This factor alone drives the input-quality gate: I < 0.60 requests better input and forces conservative mode."
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "database_match_rate": {
              "type": "object",
              "required": [
                "score"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "D — 0–1."
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "mechanism_certainty": {
              "type": "object",
              "required": [
                "score"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "M — 0–1."
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "interaction_certainty": {
              "type": "object",
              "required": [
                "score"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "X — 0–1."
                },
                "label": {
                  "type": "string"
                }
              }
            },
            "concentration_certainty": {
              "type": "object",
              "required": [
                "score"
              ],
              "properties": {
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "C — 0–1."
                },
                "label": {
                  "type": "string"
                }
              }
            }
          }
        },
        "aggregation": {
          "type": "string",
          "const": "harmonic_mean_of_five",
          "description": "M15 uses 5/(1/I+1/D+1/M+1/X+1/C), not a minimum and not an arithmetic mean."
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "standard",
            "conservative"
          ]
        },
        "total": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ],
          "description": "0–100 in standard mode; must be null in conservative mode (enforced below)."
        },
        "confidence_label": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "weight"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "presence_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_multiplier": {
                "type": "number",
                "minimum": 0,
                "maximum": 1.2
              },
              "interaction_modifier": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 1.2
              },
              "dimension_score": {
                "type": "number"
              },
              "contribution": {
                "type": "number"
              }
            }
          }
        },
        "weight_total": {
          "type": "number",
          "description": "Must equal 100 for the applied profile."
        },
        "marketing_penalty": {
          "type": "number",
          "maximum": 0
        }
      }
    },
    "conclusion": {
      "type": "object",
      "required": [
        "strengths",
        "limitations",
        "recommendation"
      ],
      "properties": {
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recommendation": {
          "type": "string"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    },
    "skipped_modules": {
      "type": "array",
      "description": "Required whenever any module was skipped (SKILL.md: record the degradation path).",
      "items": {
        "type": "object",
        "required": [
          "module",
          "reason",
          "confidence_impact"
        ],
        "properties": {
          "module": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "confidence_impact": {
            "type": "string"
          }
        }
      }
    },
    "data_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required in conservative mode."
    },
    "remediation": {
      "type": "string",
      "description": "Required in conservative mode — how to obtain a better analysis."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "mode": {
                    "const": "conservative"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scoring": {
            "properties": {
              "total": {
                "type": "null"
              }
            },
            "required": [
              "total"
            ]
          },
          "data_gaps": {
            "type": "array",
            "minItems": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "scoring": {
            "properties": {
              "total": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "total"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "score": {
                    "minimum": 80
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "label": {
                    "const": "high"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "score": {
                    "minimum": 60,
                    "exclusiveMaximum": 80
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "label": {
                    "const": "medium"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "score": {
                    "minimum": 40,
                    "exclusiveMaximum": 60
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "label": {
                    "const": "low"
                  },
                  "mode": {
                    "const": "conservative"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "score": {
                    "exclusiveMaximum": 40
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "meta": {
            "properties": {
              "confidence": {
                "properties": {
                  "label": {
                    "const": "critical"
                  },
                  "mode": {
                    "const": "conservative"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
